APP_NAME="Titan Zero WorkCore"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=workcore
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

AI_PROVIDER=
AI_API_KEY=
AI_MODEL=


# Titan Zero / WorkCore host integration
WORKCORE_ENABLED=true
WORKCORE_REQUIRE_TENANT=true
WORKCORE_TENANCY_ROUTES_ENABLED=false
WORKCORE_API_ROUTES_ENABLED=false
WORKCORE_DOCUMENTS_ENABLED=true
WORKCORE_DOCUMENTS_ROUTES_ENABLED=false
WORKCORE_ASSURANCE_ENABLED=true
WORKCORE_ASSURANCE_ROUTES_ENABLED=false
WORKCORE_TRUST_ACCOUNTING_ENABLED=false
WORKCORE_TRUST_ACCOUNTING_ROUTES_ENABLED=false
WORKCORE_DEFAULT_TIMEZONE=Australia/Melbourne
WORKCORE_DEFAULT_CURRENCY=AUD
WORKCORE_DEFAULT_COUNTRY=AU

# WorkCore production reliability
WORKCORE_OUTBOX_MAX_ATTEMPTS=10
WORKCORE_OUTBOX_RETRY_SECONDS=60
WORKCORE_OUTBOX_MAX_RETRY_SECONDS=3600
WORKCORE_OUTBOX_PROCESSING_TIMEOUT_SECONDS=300
WORKCORE_SYNC_RETRY_SECONDS=60
WORKCORE_SYNC_PROCESSING_TIMEOUT_SECONDS=300

# Titan Zero Unified extension providers (comma-separated FQCNs).
# Extensions are installed but disabled by default pending host validation.
TITAN_UNIFIED_EXTENSION_PROVIDERS=
