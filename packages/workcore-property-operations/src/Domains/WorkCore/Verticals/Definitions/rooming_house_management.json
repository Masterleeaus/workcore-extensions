{
  "key": "rooming_house_management",
  "label": "Rooming House Management",
  "version": "1.0.0",
  "type": "vertical",
  "extends": [
    "accommodation_core"
  ],
  "capabilities": [
    "workcore.recurring",
    "workcore.compliance"
  ],
  "features": {
    "rooming_house.residents": true,
    "rooming_house.rooms": true,
    "rooming_house.common_areas": true,
    "rooming_house.compliance": true,
    "rooming_house.incidents": true
  },
  "terminology": {
    "entity.customer.singular": "Resident",
    "entity.customer.plural": "Residents",
    "entity.premises.singular": "Rooming house",
    "entity.premises.plural": "Rooming houses",
    "entity.work_order.singular": "Resident request",
    "entity.work_order.plural": "Resident requests"
  },
  "metadata": {
    "managed_premises_profile": "rooming_house",
    "rebased_for_workcore": "0.42.0-unified"
  },
  "setup": {
    "default_business_lines": [
      {
        "key": "rooming_house_operations",
        "name": "Rooming House Operations"
      }
    ],
    "questions": [
      {
        "key": "rooming_house.property_count",
        "section": "vertical_details",
        "prompt": "How many rooming-house properties should be configured initially?",
        "type": "integer",
        "required": true
      },
      {
        "key": "rooming_house.room_inventory",
        "section": "vertical_details",
        "prompt": "Should room and bed inventory be created during setup?",
        "type": "boolean",
        "required": true,
        "default": true
      },
      {
        "key": "rooming_house.compliance_program",
        "section": "compliance",
        "prompt": "Should recurring safety and compliance inspections be generated?",
        "type": "boolean",
        "required": true,
        "default": true
      }
    ],
    "documents": [
      "resident_handbook",
      "incident_report",
      "maintenance_report",
      "emergency_procedure"
    ]
  },
  "codebooks": {
    "roster.type": {
      "include": [
        "rooming_house",
        "maintenance",
        "inspection",
        "housekeeping",
        "compliance"
      ],
      "default": "rooming_house"
    },
    "roster.shift_type": {
      "include": [
        "rooming_house",
        "maintenance",
        "inspection",
        "housekeeping",
        "compliance"
      ],
      "default": "rooming_house"
    },
    "worker.type": {
      "include": [
        "accommodation_worker",
        "housekeeper",
        "maintenance",
        "inspector"
      ],
      "default": "accommodation_worker"
    }
  }
}
