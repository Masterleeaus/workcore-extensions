{
  "key": "ndis_service_provider",
  "label": "NDIS Service Provider",
  "version": "1.1.0",
  "type": "vertical",
  "extends": [
    "regulated_care_core"
  ],
  "capabilities": [
    "workcore.dispatch",
    "workcore.rosters",
    "workcore.inventory",
    "workcore.reviews",
    "workcore.people",
    "workcore.people.compliance",
    "workcore.attendance.verification",
    "workcore.compliance",
    "workcore.recurring",
    "workcore.payroll",
    "workcore.ndis"
  ],
  "features": {
    "ndis.participants": true,
    "ndis.service_agreements": true,
    "ndis.support_plans": true,
    "ndis.progress_notes": true,
    "ndis.incident_management": true,
    "ndis.worker_compliance": true,
    "ndis.claim_support": true,
    "ndis.plans": true,
    "ndis.budgets": true,
    "ndis.goals": true,
    "ndis.support_delivery": true,
    "ndis.protected_case_notes": true,
    "ndis.incident_links": true,
    "ndis.worker_matching": true,
    "ndis.claim_preparation": true
  },
  "terminology": {
    "entity.customer.singular": "Participant",
    "entity.customer.plural": "Participants",
    "entity.premises.singular": "Service location",
    "entity.premises.plural": "Service locations",
    "entity.work_order.singular": "Support service",
    "entity.work_order.plural": "Support services",
    "entity.worker.singular": "Support worker",
    "entity.worker.plural": "Support workers"
  },
  "metadata": {
    "managed_premises_profile": "service_site",
    "rebased_for_workcore": "0.42.0-unified",
    "ndis_operations_pass": "0.45.0"
  },
  "setup": {
    "default_business_lines": [
      {
        "key": "community_support",
        "name": "Community Support"
      }
    ],
    "questions": [
      {
        "key": "ndis.registration_status",
        "section": "compliance",
        "prompt": "What is the provider registration status?",
        "type": "select",
        "required": true,
        "options": [
          "registered",
          "unregistered",
          "registration_in_progress"
        ]
      },
      {
        "key": "ndis.support_classes",
        "section": "vertical_details",
        "prompt": "Which NDIS support classes should be configured?",
        "type": "multiselect",
        "required": true,
        "options": [
          "assistance_with_daily_life",
          "transport",
          "community_participation",
          "capacity_building",
          "support_coordination",
          "household_tasks",
          "assistive_technology",
          "accommodation_support"
        ]
      },
      {
        "key": "ndis.worker_screening_required",
        "section": "compliance",
        "prompt": "Should worker-screening, training and qualification checks be mandatory?",
        "type": "boolean",
        "required": true,
        "default": true
      },
      {
        "key": "ndis.funding_management",
        "section": "commercial",
        "prompt": "Which funding-management methods should be supported?",
        "type": "multiselect",
        "required": false,
        "options": [
          "agency_managed",
          "plan_managed",
          "self_managed"
        ]
      }
    ],
    "documents": [
      "participant_service_agreement",
      "incident_report",
      "staff_induction",
      "risk_assessment",
      "emergency_procedure"
    ]
  },
  "codebooks": {
    "roster.type": {
      "include": [
        "participant_support",
        "community_support",
        "on_call"
      ],
      "default": "participant_support"
    },
    "roster.shift_type": {
      "include": [
        "participant_support",
        "community_support",
        "on_call"
      ],
      "default": "participant_support"
    },
    "worker.type": {
      "include": [
        "support_worker"
      ],
      "default": "support_worker"
    },
    "appointment.type": {
      "include": [
        "participant_support",
        "meeting"
      ],
      "default": "participant_support"
    },
    "dispatch.assignment_type": {
      "include": [
        "participant_support",
        "emergency"
      ],
      "default": "participant_support"
    }
  }
}
