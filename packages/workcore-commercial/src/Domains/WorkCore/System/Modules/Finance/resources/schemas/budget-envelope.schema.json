  "required": [
    "company_id",
    "allocated_minor",
    "currency_code"
  ],
  "properties": {
    "company_id": {
      "type": "string"
    },
    "allocated_minor": {
      "type": "integer",
      "minimum": 0
    },
    "currency_code": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
