{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expense Claim",
  "type": "object",
  "required": [
    "claimant_id",
    "amount_minor",
    "receipt_ids"
  ],
  "properties": {
    "claimant_id": {
      "type": "string"
    },
    "amount_minor": {
      "type": "integer",
      "minimum": 1
    },
    "receipt_ids": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}
