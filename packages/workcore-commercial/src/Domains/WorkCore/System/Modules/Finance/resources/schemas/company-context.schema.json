{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company Context",
  "type": "object",
  "required": [
    "company_id",
    "base_currency"
  ],
  "properties": {
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "base_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  },
  "additionalProperties": true
}
