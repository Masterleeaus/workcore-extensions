{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Financial Document Snapshot",
  "type": "object",
  "required": [
    "document_type",
    "document_id",
    "payload_hash"
  ],
  "properties": {
    "document_type": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  },
  "additionalProperties": true
}
